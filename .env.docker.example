# Variables para `docker compose`. Copia este archivo a .env.docker y llena los valores.
# Nunca subas .env.docker al repositorio.
#
# DB_HOST, DB_PORT, DB_NAME, HOST, PORT y UPLOADS_DIR los fija docker-compose.yml.

# ---------- Base de datos (contenedor db) ----------
# Contraseña de root de MariaDB. Genera una con: openssl rand -base64 24
MARIADB_ROOT_PASSWORD=
# Usuario de la API: el script de inicio lo crea con permisos solo de datos.
DB_USER=aalcuadrado_api
# Genera una con: openssl rand -base64 24 | tr -d '/+='
DB_PASSWORD=

# ---------- API ----------
# URL pública de la API (la del túnel), sin "/" al final.
PUBLIC_URL=https://api.tudominio.com
# Orígenes que pueden llamar a la API desde el navegador, separados por comas.
CORS_ORIGINS=https://aimtonio.github.io
# Al menos 32 caracteres aleatorios. Genera uno con: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRA_SEGUNDOS=28800
UPLOADS_MAX_MB=10

# ---------- Túnel de Cloudflare (solo con --profile tunel) ----------
# Zero Trust → Networks → Tunnels → tu túnel → token de instalación.
# En "Public Hostname" el servicio debe ser: http://api:3000
TUNNEL_TOKEN=
