# Copia este archivo a .env y llena los valores. Nunca subas .env al repositorio.

NODE_ENV=development
# 127.0.0.1: la API solo escucha en la propia máquina; cloudflared la expone hacia afuera.
HOST=127.0.0.1
PORT=3000
# URL pública de la API (la del túnel), sin "/" al final. Con ella se arma la URL de cada foto.
PUBLIC_URL=http://localhost:3000
# Orígenes que pueden llamar a la API desde el navegador, separados por comas.
# El panel vive en el mismo dominio que la API y no necesita estar aquí.
CORS_ORIGINS=http://localhost:4321,https://aimtonio.github.io

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aalcuadrado_api
DB_PASSWORD=CAMBIA_ESTA_CONTRASENA
DB_NAME=aalcuadrado

# Al menos 32 caracteres aleatorios. Genera uno con: openssl rand -base64 48
JWT_SECRET=
# Duración del token en segundos (28800 = 8 horas).
JWT_EXPIRA_SEGUNDOS=28800

# Carpeta donde se guardan las fotos (ruta absoluta recomendada).
UPLOADS_DIR=./uploads
# Tamaño máximo por foto, en MB.
UPLOADS_MAX_MB=10
