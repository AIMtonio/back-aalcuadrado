          }
        }
      ]
    },
    {
      "name": "Diseños con IA",
      "description": "Públicos (sin token): los llama el sitio. Generan con OpenAI la imagen de unos aretes a partir de una idea.",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "Estado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/disenos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "disenos"
              ]
            },
            "description": "`disponible`: si hay OPENAI_API_KEY y queda cupo. `restantesHoy`: imágenes que quedan hoy."
          }
        },
        {
          "name": "Generar diseño",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Calaveritas de azúcar con flores de cempasúchil, en morado y naranja\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/disenos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "disenos"
              ]
            },
            "description": "200 `{ imagen, restantesHoy }`; `imagen` es `data:image/webp;base64,…`. Tarda de 20 a 60 s. Máximo OPENAI_MAX_IMAGENES_VISITANTE (5) diseños por visitante por hora; los que fallan no cuentan."
          }
        }
      ]
    },
    {
      "name": "Kits (colores y aromas)",
      "description": "Colores y aromas para armar kits de jabón y vela. Piden token. Las fotos de kits se suben en Imágenes con categoria=kits.",
      "item": [
        {
