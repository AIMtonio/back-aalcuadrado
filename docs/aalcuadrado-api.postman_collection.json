              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('categoriaSlug', pm.response.json().slug);"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categorias/{{categoriaSlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias",
                "{{categoriaSlug}}"
              ]
            },
            "description": "Una categoría por slug."
          }
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categorias/{{categoriaSlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias",
                "{{categoriaSlug}}"
              ]
            },
            "description": "`nombre` y/o `orden`, todo opcional. El slug no cambia.",
            "body": {
