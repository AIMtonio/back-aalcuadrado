                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias"
              ]
            },
            "description": "`nombre` obligatorio. Sin `slug`, se arma del nombre. Guarda el slug en la variable `categoriaSlug`.",
            "body": {
