        {
          "name": "Borrar",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categorias/{{categoriaSlug}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias",
                "{{categoriaSlug}}"
              ]
            },
            "description": "204. Si la categoría tiene productos asignados responde 409."
          }
        }
      ]
    },
    {
      "name": "Imágenes",
      "item": [
        {
          "name": "Listar todas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imagenes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "imagenes"
              ]
            },
            "description": "Todas las fotos, ordenadas por `orden` y luego por `id`. Cada una trae su `url` pública."
          }
        },
        {
          "name": "Listar galería",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imagenes?categoria=galeria",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "imagenes"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "galeria"
                }
              ]
            },
            "description": "Solo la sección \"Así se ven\"."
          }
        },
        {
          "name": "Listar de un producto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imagenes?categoria=productos&producto=nochebuena",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "imagenes"
              ],
              "query": [
                {
                  "key": "categoria",
                  "value": "productos"
                },
                {
                  "key": "producto",
                  "value": "nochebuena"
                }
              ]
            },
            "description": "Fotos de un producto. `producto` es el slug del JSON del front."
          }
        },
        {
          "name": "Subir",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imagenes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "imagenes"
              ]
            },
            "description": "`multipart/form-data`. En `archivos` elige de 1 a 10 fotos (JPG, PNG, WebP o AVIF; 10 MB cada una). Guarda en variables el `id`, la categoría y el archivo de la primera.",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "archivos",
                  "type": "file",
                  "src": [],
                  "description": "Repite este campo para subir varias"
                },
                {
                  "key": "categoria",
                  "value": "productos",
                  "type": "text",
                  "description": "productos | galeria"
                },
                {
                  "key": "producto",
                  "value": "nochebuena",
                  "type": "text",
                  "description": "Slug de un producto existente (obligatorio si categoria=productos)"
                },
                {
                  "key": "color",
                  "value": "rojo",
                  "type": "text",
                  "description": "Id de un color de ese producto (opcional)"
                },
                {
                  "key": "alt",
                  "value": "Aretes Nochebuena en color rojo",
                  "type": "text",
                  "description": "Texto alternativo (opcional)"
                },
                {
                  "key": "orden",
                  "value": "0",
                  "type": "text",
                  "description": "Entero (opcional)"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "const [primera] = pm.response.json();",
                  "if (primera) {",
                  "  pm.collectionVariables.set('imagenId', primera.id);",
                  "  pm.collectionVariables.set('categoria', primera.categoria);",
                  "  pm.collectionVariables.set('archivo', primera.archivo);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imagenes/{{imagenId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "imagenes",
                "{{imagenId}}"
              ]
            },
            "description": "Una foto por id (404 si no existe)."
          }
        },
        {
          "name": "Actualizar",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imagenes/{{imagenId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "imagenes",
                "{{imagenId}}"
              ]
            },
            "description": "Cambia cualquier campo: `alt`, `producto`, `color`, `orden`, `categoria`. `\"\"` o `null` borra el valor. Si cambia `categoria`, el archivo se mueve de carpeta.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alt\": \"Aretes Nochebuena, vista de frente\",\n  \"orden\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Borrar",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/imagenes/{{imagenId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "imagenes",
                "{{imagenId}}"
              ]
            },
            "description": "Borra el registro y el archivo. Responde 204."
          }
        }
      ]
    },
    {
      "name": "Pedidos de kits (jabón + vela)",
      "description": "El sitio está creciendo de aretes a también vender kits de jabón + vela a la medida. Crear un pedido es público (sin token); listarlos y borrarlos es para el panel.",
      "item": [
        {
          "name": "Crear (público)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "description": "Los 8 campos son obligatorios. `clienteContacto` es un correo o un teléfono. Sin catálogo fijo de colores/aromas/formas/toppings: el front manda lo que elija quien visita. Máximo 5 por minuto por IP. Guarda el `id` en la variable `pedidoId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clienteNombre\": \"Ana\",\n  \"clienteContacto\": \"ana@correo.com\",\n  \"jabonColor\": \"Lavanda\",\n  \"jabonAroma\": \"Lavanda\",\n  \"jabonForma\": \"Corazón\",\n  \"velaColor\": \"Blanco\",\n  \"velaAroma\": \"Vainilla\",\n  \"velaTopping\": \"Flores secas\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('pedidoId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "description": "Pedidos de kits, del más reciente al más viejo. Pide token (lo usa el panel para cotizarlos a mano)."
          }
        },
        {
          "name": "Borrar",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pedidos/{{pedidoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pedidos",
                "{{pedidoId}}"
              ]
            },
            "description": "204. Bórralo cuando ya lo hayas cotizado y hecho el pedido."
          }
        }
      ]
    },
    {
      "name": "Publicación",
      "item": [
        {
          "name": "Estado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/publicacion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
